{
  "name": "suiteonix",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "bun --env-file=.env --filter @suiteonix/admin dev",
    "dev:customer": "bun --env-file=.env --filter @suiteonix/customer dev",
    "build:admin": "bun --env-file=.env --filter @suiteonix/admin build",
    "build:customer": "bun --env-file=.env --filter @suiteonix/customer build"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
